# Dependencias
node_modules/
**/node_modules/

# Variables de entorno / secretos
.env
.env.*
!.env.example
**/.env
!**/.env.example

# Builds
dist/
dist-ssr/
build/
frontend/dist/

# Logs
logs/
*.log
**/logs/*
!**/logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads (contenido subido por usuarios)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/**/.gitkeep

# Backups de base de datos (contienen datos personales)
database/*.sql
*.sql.gz
*.dump

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.swp
